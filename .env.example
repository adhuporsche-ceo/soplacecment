NODE_ENV=development
PORT=5000

# Backend-only MongoDB Atlas configuration. Never use VITE_ prefixes here.
MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Optional. Uses the database in MONGODB_URI, or student_placement if omitted.
MONGODB_DB_NAME=

# Generate a new random value for each deployment. Do not reuse the example.
JWT_SECRET=replace_with_a_new_random_secret
JWT_EXPIRES_IN=7d

# Server-only bootstrap credentials. Replace every placeholder before deployment.
# Do not add a VITE_ prefix to these variables.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_random_password
FACULTY_EMAIL=faculty@example.com
FACULTY_LOGIN_PASSWORD=replace_with_a_unique_random_password

# Optional application URL.
APP_URL=
