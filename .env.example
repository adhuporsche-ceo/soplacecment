NODE_ENV=development
PORT=5000

# Backend-only MongoDB Atlas configuration. Never use VITE_ prefixes here.
MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=miltray_mangementSystem

# Generate a new random value for each deployment. Do not reuse the example.
JWT_SECRET=replace_with_a_new_random_secret
JWT_EXPIRES_IN=7d

# Server-only sign-in credentials. Replace every placeholder before deployment.
# Do not add a VITE_ prefix to these variables.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_random_password
PLACEMENT_COORDINATOR_EMAIL=coordinator@example.com
PLACEMENT_COORDINATOR_PASSWORD=replace_with_a_unique_random_password
FACULTY_EMAIL=faculty@example.com
FACULTY_LOGIN_PASSWORD=replace_with_a_unique_random_password
INSTITUTION_EMAIL=institution@example.com
INSTITUTION_NAME=Institution Administrator
INSTITUTION_LOGIN_PASSWORD=replace_with_a_unique_random_password

# Optional AI Studio settings for this existing application.
GEMINI_API_KEY=
APP_URL=
